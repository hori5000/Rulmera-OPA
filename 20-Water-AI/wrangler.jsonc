{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "water-ai",
  "main": "./worker/basic-auth.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./.web-public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}

