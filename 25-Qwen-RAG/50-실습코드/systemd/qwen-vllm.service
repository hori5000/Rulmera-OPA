[Unit]
Description=Qwen3.8 vLLM Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qwenrag
WorkingDirectory=/home/qwenrag/qwen-rag/llm
Environment=HF_HOME=/home/qwenrag/.cache/huggingface
ExecStart=/home/qwenrag/qwen-rag/llm/.venv-llm/bin/vllm serve Qwen/Qwen3.8-27B-FP8 --served-model-name qwen3.8-27b --host 127.0.0.1 --port 8000 --tensor-parallel-size 1 --max-model-len 16384 --gpu-memory-utilization 0.88 --max-num-seqs 1
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
